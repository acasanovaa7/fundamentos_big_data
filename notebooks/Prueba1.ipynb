    "from pyspark.sql import SparkSession\n",
    "\n",
    "# Crear sesión de Spark\n",
    "spark = SparkSession.builder.appName(\"DemoClase\").getOrCreate()\n",
    "\n",
    "# Datos de ejemplo\n",
    "data = [(\"Alice\", 34), (\"Bob\", 45), (\"Carmen\", 29)]\n",
    "df = spark.createDataFrame(data, [\"Nombre\", \"Edad\"])\n",
    "\n",
    "df.show()"
